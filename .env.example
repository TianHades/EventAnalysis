# 复制本文件为 .env 后填写（.env 不入 git，仅本模板入库）
# 位置：项目根目录 D:/workspace/01-投研主链/突发事件影响分析/.env

# === LLM 网关（GLM / Zhipu，必需）===
# Claude Code CLI（推理节点）必需；Embedder 的 zhipu 后端 token 也可回退到这里
# （也可单独设置 ZHIPU_API_KEY，见 README「配置」的 Embedding 说明）
ANTHROPIC_AUTH_TOKEN=你的_GLM_网关_token
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# === CLI 默认值（可选，缺省用下列值）===
EVENTREPLAY_MODEL=sonnet                       # 推理节点模型别名
EVENTREPLAY_BENCHMARK=sh000300                 # 基准指数（sina 符号；沪深300价格指数；港股 --market 港股 未指定时自动切 HSI）
EVENTREPLAY_DB=data/eventreplay.db             # SQLite 路径
EMBEDDING_BACKEND=auto                         # auto=智谱 embedding-3 可达则在线(2048 维)/否则本地 bge-small-zh-v1.5(512 维)，首次锁定后不切换；可强制 zhipu / local

# === 监测系统（可选，monitor 命令）===
MONITOR_INTERVAL=240              # 扫描间隔（分钟，默认 240=4 小时）
FEISHU_WEBHOOK=                   # 飞书自定义机器人 webhook URL（留空=不推送飞书）

# === tushare pro（权威成分股源；可选）===
# 有 token 则 CandidateGen 用 tushare 概念/申万成分股做权威召回，替掉手工 themes.yaml
# 注册免费拿 token：https://tushare.pro
TUSHARE_TOKEN=
